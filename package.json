{
  "name": "loghorn",
  "version": "2.0.0",
  "author": "Nasr Aldin <ns@nasraldin.com> (https://nasraldin.com)",
  "description": "A powerful, flexible, and production-ready logging library for Node.js and browsers with support for multiple frameworks and environments.",
  "keywords": [
    "logging",
    "logger",
    "nodejs",
    "typescript",
    "express",
    "fastify",
    "nestjs",
    "react",
    "nextjs",
    "vue",
    "angular",
    "middleware",
    "debug",
    "colorful",
    "environment",
    "frontend",
    "client",
    "backend",
    "server",
    "api"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint",
    "lint:fix": "eslint --quiet --fix",
    "format": "prettier --write --list-different .",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "coverage": "jest --coverage --coverageReporters=html --coverageReporters=text"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "express": "5.1.0",
    "fastify": "5.4.0",
    "morgan": "^1.10.0",
    "safe-stable-stringify": "^2.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.31.0",
    "@ianvs/prettier-plugin-sort-imports": "4.5.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.14",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.5.1",
    "eslint-plugin-security": "3.0.1",
    "husky": "9.1.7",
    "jest": "^30.0.4",
    "knip": "5.61.3",
    "prettier": "3.6.2",
    "pretty-quick": "4.2.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.37.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "fastify": ">=4.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/loghorn.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/loghorn/issues"
  },
  "homepage": "https://github.com/yourusername/loghorn#readme"
}
