{
  "name": "loghorn",
  "version": "1.0.0",
  "description": "A powerful, colorful logging utility for Node.js applications with environment-specific configuration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "coverage": "jest --coverage --coverageReporters=html --coverageReporters=text"
  },
  "keywords": [
    "logging",
    "logger",
    "nodejs",
    "typescript",
    "express",
    "fastify",
    "nestjs",
    "react",
    "nextjs",
    "vue",
    "angular",
    "middleware",
    "debug",
    "colorful",
    "environment"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "chalk": "^5.0.0",
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "morgan": "^1.10.0",
    "safe-stable-stringify": "^2.5.0",
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "fastify": ">=4.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/loghorn.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/loghorn/issues"
  },
  "homepage": "https://github.com/yourusername/loghorn#readme"
}
