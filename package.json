{
  "name": "loghorn",
  "version": "2.2.0",
  "author": "Nasr Aldin <ns@nasraldin.com> (https://nasraldin.com)",
  "description": "A powerful, flexible, and production-ready logging library for Next.js with Edge Runtime support.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:fast": "jest --maxWorkers=4 --maxConcurrency=4 --cache --watchman=false --verbose=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=html --coverageReporters=text",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --quiet --fix",
    "format": "prettier --write --list-different .",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "type-check": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "safe-stable-stringify": "^2.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.32.0",
    "@ianvs/prettier-plugin-sort-imports": "4.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.3",
    "eslint-plugin-security": "3.0.1",
    "husky": "9.1.7",
    "jest": "^30.0.5",
    "knip": "5.62.0",
    "prettier": "3.6.2",
    "pretty-quick": "4.2.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.38.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nasraldin/loghorn.git"
  },
  "bugs": {
    "url": "https://github.com/nasraldin/loghorn/issues"
  },
  "homepage": "https://github.com/nasraldin/loghorn#readme",
  "keywords": [
    "logging",
    "logger",
    "typescript",
    "nextjs",
    "edge-runtime",
    "debug",
    "colorful",
    "environment",
    "frontend",
    "client",
    "backend",
    "server",
    "api"
  ]
}
